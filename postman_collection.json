{
  "info": {
    "name": "Умный кредитный кабинет MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "application_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Создать черновик",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.collectionVariables.set('application_id', pm.response.json().id);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_code\": \"WORKING_CAPITAL\",\n  \"company_name\": \"ООО Будущее дело\",\n  \"inn\": \"7707083893\",\n  \"requested_amount\": 2000000,\n  \"term_months\": 12,\n  \"purpose\": \"Закупка товара\",\n  \"annual_revenue\": 18000000,\n  \"monthly_debt_payments\": 120000,\n  \"years_in_business\": 4,\n  \"has_overdue_debt\": false,\n  \"contact_name\": \"Анна Иванова\",\n  \"contact_email\": \"demo@example.ru\"\n}"
        },
        "url": "{{base_url}}/applications"
      }
    },
    {
      "name": "2. Отправить заявку",
      "request": { "method": "POST", "url": "{{base_url}}/applications/{{application_id}}/submit" }
    },
    {
      "name": "3. Получить заявку",
      "request": { "method": "GET", "url": "{{base_url}}/applications/{{application_id}}" }
    },
    {
      "name": "4. Принять оффер",
      "request": { "method": "POST", "url": "{{base_url}}/applications/{{application_id}}/accept" }
    }
  ]
}

